# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
netlab_landing.webp
*.webp

# VM artifacts (ISO / dischi — non committare)
/vm/**/*.iso
/vm/**/*.qcow2
/vm/**/*.img
/vm/disks/
/vm/run/
/tmp/
!/vm/README.md
!/vm/.gitkeep
!/vm/reactos/.gitkeep
