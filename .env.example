# Public client settings. The anon key is safe to expose to the browser,
# but the app must not print the URL or the key in the UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Required to delete an auth user from /admin.
# Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
